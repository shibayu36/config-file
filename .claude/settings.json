{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 876000,
  "env": {
    "CLAUDE_CODE_PLUGIN_PREFER_HTTPS": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "MAX_MCP_OUTPUT_TOKENS": "50000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read(*)",
      "Search(*)",
      "Bash(rg:*)",
      "Bash(git grep:*)",
      "Bash(grep:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go mod tidy:*)",
      "Bash(go mod graph:*)",
      "Bash(go mod why:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(go get:*)",
      "Bash(gopls references:*)",
      "Bash(npm outdated:*)",
      "Bash(date:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(tree:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh search:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(gh run list:*)",
      "Bash(ghro:*)",
      "Bash(gitro:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-files:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git fetch:*)",
      "Bash(gws schema:*)",
      "Bash(gws docs documents get:*)",
      "Bash(gws drive files get:*)",
      "Bash(gws drive files list:*)",
      "Bash(gws drive files export:*)",
      "Bash(gws drive files download:*)",
      "Bash(gws drive comments get:*)",
      "Bash(gws drive comments list:*)",
      "Bash(gws sheets spreadsheets get:*)",
      "Bash(gws sheets spreadsheets getByDataFilter:*)",
      "Bash(gws sheets spreadsheets values get:*)",
      "Bash(gws sheets spreadsheets values batchGet:*)",
      "Bash(gws sheets spreadsheets values batchGetByDataFilter:*)",
      "Bash(gws sheets spreadsheets developerMetadata get:*)",
      "Bash(gws sheets spreadsheets developerMetadata search:*)",
      "Bash(gws sheets +read:*)",
      "Bash(gws slides presentations get:*)",
      "Bash(gws slides presentations pages get:*)",
      "Bash(gws slides presentations pages getThumbnail:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ln:*)",
      "Bash(sed:*)",
      "Bash(gsed:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(open:*)",
      "Bash(jira issue view:*)",
      "Bash(jira issue list:*)",
      "Bash(codex -a never review *)",
      "Bash(/Users/shibayu36/.claude/skills/gws-docs-to-markdown/scripts/read_gdoc.sh:*)",
      "Bash(/Users/shibayu36/.claude/skills/circleci-investigate/scripts/circleci.py:*)",
      "Bash(python3 /Users/shibayu36/.claude/skills/cluster-creator-kit-script/scripts/search.py:*)",
      "Bash(python3 /Users/shibayu36/.claude/skills/cluster-creator-kit-script/scripts/download.py:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:blog.shibayu36.org)",
      "mcp__serena__search_for_pattern",
      "mcp__serena__find_symbol",
      "mcp__serena__list_dir",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_referencing_symbols",
      "mcp__slack-explorer-mcp__search_messages",
      "mcp__slack-explorer-mcp__get_thread_replies",
      "mcp__slack-explorer-mcp__get_user_profiles",
      "mcp__slack-explorer-mcp__search_users_by_name",
      "mcp__slack-explorer-mcp__search_files",
      "mcp__slack-explorer-mcp__get_canvas_content"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(.env*)",
      "Read(id_rsa)",
      "Read(id_dsa)",
      "Read(id_ed25519)"
    ],
    "ask": [
      "Bash(git reset:*)",
      "Bash(git rebase:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/obsidian"
    ]
  },
  "model": "claude-fable-5[1m]",
  "skillOverrides": {
    "chat-retrospective": "off",
    "find-skills": "off",
    "gws-calendar-agenda": "off",
    "gws-calendar-insert": "off"
  },
  "hooks": {
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/direnv-on-cwd-changed.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|auth_success|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/notify-end.sh claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/block-dangerous-commands.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/notify-end.sh claude"
          }
        ]
      }
    ]
  },
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "dig@kuu-marketplace": false,
    "document-skills@anthropic-agent-skills": false,
    "gopls-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "reviewable-html-workbench@reviewable-html-workbench-local": true
  },
  "extraKnownMarketplaces": {
    "reviewable-html-workbench-local": {
      "source": {
        "source": "github",
        "repo": "u-ichi/reviewable-html-workbench"
      }
    }
  },
  "language": "日本語",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "chatgpt.com",
        "ab.chatgpt.com",
        "www.googleapis.org",
        "proxy.golang.org",
        "go.opentelemetry.io",
        "google.golang.org",
        "api.github.com",
        "127.0.0.1"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/obsidian",
        "~/Library/Caches",
        "~/go/pkg/mod/cache",
        "~/.cache",
        "/tmp",
        "~/.aws/cli/cache"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "git commit *",
      "git -C * commit*",
      "git push*",
      "git rebase *",
      "git fetch *",
      "git pull *",
      "open *",
      "codex *"
    ]
  },
  "effortLevel": "high",
  "plansDirectory": "./tmp/plans",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "preferredNotifChannel": "terminal_bell",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
